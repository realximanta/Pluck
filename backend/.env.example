# Reference file for local development only.
# Render injects real values via the dashboard — this file is NOT read in production.
# Copy to .env and fill in. Never commit .env.

PORT=8080

CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_KV_NAMESPACE_ID=your_kv_namespace_id

ADMIN_KEY=change_me_to_a_long_random_string_at_least_32_chars

AUTOPAY_KEY=your_20_character_api_key_from_auto_payment
AUTOPAY_UPI=yourname@fam
AUTOPAY_BOT_NAME=Pluck

AUTOPAY_VERIFY_URL=https://auto-payment.example.com/api/verify
AUTOPAY_QR_URL=https://qr-api-vercel.example.com/qr

PUBLIC_BASE_URL=https://pluck-server.onrender.com
